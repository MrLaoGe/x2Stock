# App settings are design-only; scripts/vocechat_notify.py reads the notification section.
X2STOCK_ENV=local
X2STOCK_BIND_HOST=127.0.0.1
X2STOCK_WEB_PORT=8080
X2STOCK_API_PORT=8140
X2STOCK_DEV_WEB_PORT=5180
X2STOCK_TIMEZONE=Asia/Shanghai
X2STOCK_LOCAL_USER_ID=local
X2STOCK_LOCAL_WORKSPACE_ID=local
X2STOCK_DATA_DIR=.local/data

# Supply user-owned credentials only in an ignored .env or deployment secrets.
POSTGRES_DB=x2stock
POSTGRES_USER=x2stock_app
POSTGRES_PASSWORD=
DATABASE_URL=
TUSHARE_TOKEN=

# Explicit protocol: responses or chat_completions; GPT model chosen by the user.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_PROTOCOL=responses
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_OUTPUT_TOKENS=2048
# 0 disables billed AI work until the owner supplies a budget.
AI_DAILY_BUDGET_CNY=0
# User-supplied gateway prices, CNY per million tokens; unknown prices block billed jobs.
AI_INPUT_CNY_PER_MILLION_TOKENS=
AI_OUTPUT_CNY_PER_MILLION_TOKENS=

# Local migration only: leave empty during normal application operation.
LEGACY_SOURCE_PATH=

# Optional Git push notifications; credentials stay local or in GitHub Actions Secrets.
VOCECHAT_ENABLED=false
VOCECHAT_BASE_URL=
VOCECHAT_API_KEY=
VOCECHAT_GROUP_ID=19
VOCECHAT_API_PREFIX=/api/bot
VOCECHAT_TIMEOUT_SECONDS=15
