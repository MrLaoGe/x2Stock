# Documentation-stage template: no application currently reads these settings.
XXSTOCK_ENV=local
XXSTOCK_BIND_HOST=127.0.0.1
XXSTOCK_WEB_PORT=8080
XXSTOCK_API_PORT=8140
XXSTOCK_DEV_WEB_PORT=5180
XXSTOCK_TIMEZONE=Asia/Shanghai
XXSTOCK_LOCAL_USER_ID=local
XXSTOCK_LOCAL_WORKSPACE_ID=local
XXSTOCK_DATA_DIR=.local/data

# Supply user-owned credentials only in an ignored .env or deployment secrets.
POSTGRES_DB=xxstock
POSTGRES_USER=xxstock_app
POSTGRES_PASSWORD=
DATABASE_URL=
TUSHARE_TOKEN=

# Explicit protocol: responses or chat_completions; GPT model chosen by the user.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_PROTOCOL=responses
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_OUTPUT_TOKENS=2048
# 0 disables billed AI work until the owner supplies a budget.
AI_DAILY_BUDGET_CNY=0

# Local migration only: leave empty during normal application operation.
LEGACY_SOURCE_PATH=
